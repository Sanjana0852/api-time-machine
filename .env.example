# Template for local settings.
# Copy this file to .env and fill in your own values.
# .env is ignored by Git, so your real password never gets committed.

# Hosts that replay may contact, comma-separated.
# Default when unset: localhost,127.0.0.1. Set but empty: no hosts at all.
# Only add hosts you have permission to send requests to.
# ATM_ALLOWED_HOSTS=localhost,127.0.0.1

# History database (PostgreSQL). Leave unset to turn history off.
ATM_DATABASE_URL=postgresql+psycopg://atm:CHANGE_ME@localhost:5432/api_time_machine

# Separate database used only by automated tests. Tests create and roll back
# rows here, so it must be a different database from ATM_DATABASE_URL.
ATM_TEST_DATABASE_URL=postgresql+psycopg://atm:CHANGE_ME@localhost:5432/api_time_machine_test
